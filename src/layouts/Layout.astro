---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";
import "../styles/fonts.css";

import ConfigCarrier from "@components/ConfigCarrier.astro";
import InstallPrompt from "@components/misc/InstallPrompt.astro";
import LoadingSpinner from "@components/misc/LoadingSpinner.astro";
import { profileConfig, siteConfig } from "@/config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { pathsEqual, url } from "../utils/url-utils";
import { getBuildVersion, addVersionToUrl } from "../utils/version-utils";
import "katex/dist/katex.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
}

let { title, banner, description, lang, setOGTypeArticle } = Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
// TODO don't use post cover as banner for now
banner = siteConfig.banner.src;

const enableBanner = siteConfig.banner.enable;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

if (!lang) {
	lang = "zh-CN";
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[siteConfig.banner.position || "center"];

const buildVersion = getBuildVersion();
---

<!DOCTYPE html>
<html lang={siteLang} class="bg-[var(--page-bg)] text-[14px] md:text-[16px] text-black"
	  data-overlayscrollbars-initialize
>
	<head>
		<script is:inline define:vars={{BANNER_HEIGHT_EXTEND, configHue}}>
			// Fixed theme color (Hue)
			document.documentElement.style.setProperty('--hue', configHue);

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
			offset = offset - offset % 4;
			document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		</script>
		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || pageTitle}>
		<meta name="author" content={profileConfig.name}>

		<meta property="og:site_name" content={siteConfig.title}>
		<meta property="og:url" content={Astro.url}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={description || pageTitle}>
		{setOGTypeArticle ? (
        <meta property="og:type" content="article" />
        ) : (
        <meta property="og:type" content="website" />
        )}

		<meta name="twitter:card" content="summary_large_image">
		<meta property="twitter:url" content={Astro.url}>
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={description || pageTitle}>

		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="oklch(0.70 0.14 250)" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content={siteConfig.title} />
		{buildVersion && <meta name="build-version" content={buildVersion} />}
		{favicons.map(favicon => (
			<link rel="icon"
				  href={favicon.src.startsWith('/') ? addVersionToUrl(url(favicon.src), buildVersion) : favicon.src}
				  sizes={favicon.sizes || "any"}
				  {...(favicon.theme ? { media: `(prefers-color-scheme: ${favicon.theme})` } : {})}
			/>
		))}
		
		<!-- PWA Manifest -->
		<link rel="manifest" href={addVersionToUrl(url('/manifest.json'), buildVersion)} />
		
		<!-- Apple Touch Icon -->
		<link rel="apple-touch-icon" href={addVersionToUrl(url('/favicon/favicon.png'), buildVersion)} />

		<style define:vars={{
			configHue,
			'page-width': `${PAGE_WIDTH}rem`,
		}}></style>  <!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->


		<slot name="head"></slot>

		<!-- Preconnect to Umami analytics for faster connection -->
		<link rel="preconnect" href="https://umami.tiwat.cn" crossorigin="anonymous" />
		<link rel="dns-prefetch" href="https://umami.tiwat.cn" />

		<!-- Preconnect to Giscus for faster connection -->
		<link rel="preconnect" href="https://giscus.app" crossorigin="anonymous" />
		<link rel="dns-prefetch" href="https://giscus.app" />

		<!-- Umami analytics - Load after user interaction or page load -->
		<script is:inline>
			// Delay loading Umami analytics until after page load or user interaction
			(function() {
				let umamiLoaded = false;
				
				function loadUmami() {
					if (umamiLoaded) return;
					umamiLoaded = true;
					
					const script = document.createElement('script');
					script.defer = true;
					script.src = 'https://umami.tiwat.cn/script.js';
					script.setAttribute('data-website-id', 'bc649744-c75f-4772-9c9e-5801448df5c1');
					script.crossOrigin = 'anonymous';
					document.head.appendChild(script);
				}
				
				// Load after page is fully loaded
				if (document.readyState === 'complete') {
					setTimeout(loadUmami, 1000);
				} else {
					window.addEventListener('load', () => {
						setTimeout(loadUmami, 1000);
					});
				}
				
				// Load immediately on user interaction (click, scroll, keypress)
				const events = ['click', 'scroll', 'keydown', 'touchstart'];
				events.forEach(event => {
					document.addEventListener(event, loadUmami, { once: true, passive: true });
				});
			})();
		</script>

		<link rel="alternate" type="application/rss+xml" title={profileConfig.name} href={`${Astro.site}rss.xml`}/>

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" is:inline define:vars={{
			title: siteConfig.title,
			description: description || siteConfig.subtitle,
			author: profileConfig.name,
			url: Astro.url,
			image: profileConfig.avatar ? (profileConfig.avatar.startsWith('http') ? profileConfig.avatar : url(profileConfig.avatar)) : "",
			isHomePage: pathsEqual(Astro.url.pathname, url("/")),
			homeUrl: url("/"),
			pageTitle: title
		}}>
			{
				"@context": "https://schema.org",
				"@graph": [
					{
						"@type": "WebSite",
						"@id": homeUrl + "#website",
						"url": homeUrl,
						"name": title,
						"description": description,
						"author": {
							"@type": "Person",
							"name": author,
							"image": image
						}
					},
					{
						"@type": "BreadcrumbList",
						"@id": url + "#breadcrumb",
						"itemListElement": [
							{
								"@type": "ListItem",
								"position": 1,
								"item": {
									"@id": homeUrl,
									"name": "Home"
								}
							}
							].concat(isHomePage ? [] : [
								{
									"@type": "ListItem",
									"position": 2,
									"item": {
										"@id": url,
										"name": pageTitle
									}
								}
							])
					}
				]
			}
		</script>
	</head>
	<body class=" min-h-screen " class:list={[{"is-home": isHomePage, "enable-banner": enableBanner}]}
		  data-overlayscrollbars-initialize
	>
		<LoadingSpinner />
		<ConfigCarrier></ConfigCarrier>
		<InstallPrompt></InstallPrompt>
		<a href="#swup-container" class="sr-only focus:not-sr-only absolute z-[100] bg-[var(--primary)] text-white px-4 py-2 m-2 rounded-lg">
			跳过导航内容
		</a>
		<slot />
	</body>
</html>

<style is:global define:vars={{
	bannerOffset,
	'banner-height-home': `${BANNER_HEIGHT_HOME}dvh`,
	'banner-height': `${BANNER_HEIGHT}dvh`,
}}>
@tailwind components;
@layer components {
	.enable-banner.is-home #banner-wrapper {
		@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)]
	}
	.enable-banner #banner-wrapper {
		@apply h-[var(--banner-height-home)]
	}

	.enable-banner.is-home #banner {
		@apply h-[var(--banner-height-home)] translate-y-0
	}
	.enable-banner #banner {
		@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)]
	}
	.enable-banner.is-home #main-grid {
		@apply translate-y-[var(--banner-height-extend)];
	}
	.enable-banner #top-row {
		@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-[height] duration-200
	}
	.enable-banner.is-home #sidebar-sticky {
		@apply top-[calc(1rem_-_var(--banner-height-extend))]
	}
	.navbar-hidden {
		@apply opacity-0 -translate-y-16 pointer-events-none invisible
	}
}
</style>

<script>
import 'overlayscrollbars/overlayscrollbars.css';
import {
	OverlayScrollbars,
} from 'overlayscrollbars';
import {getHue, setHue} from "../utils/setting-utils";
import {pathsEqual, url} from "../utils/url-utils";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_HOME,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT
} from "../constants/constants";
import { siteConfig } from '../config';


const bannerEnabled = !!document.getElementById('banner-wrapper')

function setClickOutsideToClose(panel: string, ignores: string[]) {
	document.addEventListener("click", event => {
		let panelDom = document.getElementById(panel);
		if (!panelDom) return;
		let tDom = event.target;
		if (!(tDom instanceof Node)) return;		// Ensure the event target is an HTML Node
		for (let ig of ignores) {
			let ie = document.getElementById(ig)
			if (ie == tDom || (ie?.contains(tDom))) {
				return;
			}
		}
		panelDom.classList.add("float-panel-closed");
	});
}
setClickOutsideToClose("display-setting", ["display-setting", "display-settings-switch"])
setClickOutsideToClose("nav-menu-panel", ["nav-menu-panel", "nav-menu-switch"])
setClickOutsideToClose("search-panel", ["search-panel", "search-bar", "search-switch"])


function loadHue() {
	setHue(getHue())
}

let bodyScrollbarInstance: any = null;

function initCustomScrollbar() {
	const bodyElement = document.querySelector('body');
	if (!bodyElement) return;
	
	// Optimize OverlayScrollbars configuration for better performance
	bodyScrollbarInstance = OverlayScrollbars(
		{
			target: bodyElement,
			cancel: {
				nativeScrollbarsOverlaid: true,    // don't initialize the overlay scrollbar if there is a native one
			}
		}, {
		scrollbars: {
			theme: 'scrollbar-base scrollbar-auto py-1',
			autoHide: 'move',
			autoHideDelay: 300,  // Reduced from 500ms for faster hiding
			autoHideSuspend: false,
			clickScroll: true,
		},
	});

	const katexElements = document.querySelectorAll('.katex-display') as NodeListOf<HTMLElement>;

	const katexObserverOptions = {
		root: null,
		rootMargin: '100px',
		threshold: 0.1
	};

	// Use requestIdleCallback for non-critical katex processing
	const processKatexElement = (element: HTMLElement) => {
		if (!element.parentNode) return;
		if (element.hasAttribute('data-scrollbar-initialized')) return;

		// Use requestIdleCallback to defer non-critical work
		const process = () => {
			if (!element.parentNode) return;
			
			const container = document.createElement('div');
			container.className = 'katex-display-container';
			container.setAttribute('aria-label', 'scrollable container for formulas');

			element.parentNode.insertBefore(container, element);
			container.appendChild(element);

			OverlayScrollbars(container, {
				scrollbars: {
					theme: 'scrollbar-base scrollbar-auto',
					autoHide: 'leave',
					autoHideDelay: 300,  // Reduced delay
					autoHideSuspend: false
				},
			});

			element.setAttribute('data-scrollbar-initialized', 'true');
		};

		// Use requestIdleCallback if available, otherwise setTimeout
		if ('requestIdleCallback' in window) {
			(window as any).requestIdleCallback(process, { timeout: 1000 });
		} else {
			setTimeout(process, 0);
		}
	};

	const katexObserver = new IntersectionObserver((entries, observer) => {
		// Process entries in batches to avoid blocking
		entries.forEach((entry, index) => {
			if (entry.isIntersecting) {
				// Stagger processing to avoid blocking
				setTimeout(() => {
					processKatexElement(entry.target as HTMLElement);
					observer.unobserve(entry.target);
				}, index * 10);
			}
		});
	}, katexObserverOptions);

	katexElements.forEach(element => {
		katexObserver.observe(element);
	});
}

function showBanner() {
	if (!siteConfig.banner.enable) return;

	const banner = document.getElementById('banner');
	if (!banner) {
		console.error('Banner element not found');
		return;
	}

	banner.classList.remove('opacity-0', 'scale-105');
}

function cleanupAnimationWillChange() {
	const animatedElements = document.querySelectorAll('.onload-animation');
	animatedElements.forEach((element) => {
		const handleAnimationEnd = (event: Event) => {
			const animEvent = event as AnimationEvent;
			if (animEvent.target === element) {
				(element as HTMLElement).classList.add('animation-complete');
				element.removeEventListener('animationend', handleAnimationEnd as EventListener);
			}
		};
		element.addEventListener('animationend', handleAnimationEnd as EventListener);
	});
}

function init() {
	loadHue();
	showBanner();
	cleanupAnimationWillChange();
	
	// Delay OverlayScrollbars initialization to avoid blocking initial render
	// Use requestIdleCallback if available, otherwise setTimeout
	if ('requestIdleCallback' in window) {
		(window as any).requestIdleCallback(() => {
			initCustomScrollbar();
		}, { timeout: 2000 });
	} else {
		setTimeout(() => {
			initCustomScrollbar();
		}, 100);
	}
}

/* Load settings when entering the site */
init();

// Update navbar active state based on current URL
function updateNavbarActiveState(currentUrl: string) {
	// Get the pathname from the URL
	const urlObj = new URL(currentUrl, window.location.origin);
	const currentPath = urlObj.pathname;
	
	// Update desktop navbar links
	const navbarLinks = document.querySelectorAll('.navbar-link[data-navlink-url]');
	navbarLinks.forEach((link) => {
		const linkUrl = link.getAttribute('data-navlink-url');
		if (linkUrl && pathsEqual(currentPath, linkUrl)) {
			link.classList.add('active');
		} else {
			link.classList.remove('active');
		}
	});
	
	// Update mobile nav menu links
	const menuLinks = document.querySelectorAll('.nav-menu-link[data-navlink-url]');
	menuLinks.forEach((link) => {
		const linkUrl = link.getAttribute('data-navlink-url');
		if (linkUrl && pathsEqual(currentPath, linkUrl)) {
			link.classList.add('active');
		} else {
			link.classList.remove('active');
		}
	});
}

// Initialize navbar active state on page load
updateNavbarActiveState(window.location.href);

const setup = () => {
	window.swup.hooks.on('link:click', () => {
		document.documentElement.style.setProperty('--content-delay', '0ms')

		const sidebar = document.getElementById('sidebar');
		if (sidebar && window.innerWidth < 1024) {
			sidebar.style.display = 'none';
		}

		setTimeout(() => {
			if (!bannerEnabled) {
				return
			}
			const isHome = document.body.classList.contains('is-home');
			const currentBannerHeight = isHome ? BANNER_HEIGHT_HOME : BANNER_HEIGHT;
			const NAVBAR_HEIGHT = 72;
			const MAIN_PANEL_EXCESS_HEIGHT = MAIN_PANEL_OVERLAPS_BANNER_HEIGHT * 16;
			const threshold = window.innerHeight * (currentBannerHeight / 100) - NAVBAR_HEIGHT - MAIN_PANEL_EXCESS_HEIGHT - 16;
			
			const navbar = document.getElementById('navbar-wrapper')
			if (!navbar) {
				return
			}
			const scrollTop = document.body.scrollTop || document.documentElement.scrollTop;
			if (scrollTop >= threshold) {
				navbar.classList.add('navbar-hidden')
			} else {
				navbar.classList.remove('navbar-hidden')
			}
		}, 0);
	})
	window.swup.hooks.on('content:replace', (visit: any) => {
		// Re-initialize cached elements after content replacement
		initScrollElements();
		
		const sidebar = document.getElementById('sidebar');
		if (sidebar && window.innerWidth < 1024) {
			sidebar.style.display = 'none';
		}

		// Update body class based on target page
		const bodyElement = document.querySelector('body')
		if (pathsEqual(visit.to.url, url('/'))) {
			bodyElement!.classList.add('is-home');
		} else {
			bodyElement!.classList.remove('is-home');
		}
		
		// Update navbar active state
		updateNavbarActiveState(visit.to.url);
		
		// Delay scrollbar re-initialization to avoid blocking
		if ('requestIdleCallback' in window) {
			(window as any).requestIdleCallback(() => {
				initCustomScrollbar();
			}, { timeout: 1000 });
		} else {
			setTimeout(() => {
				initCustomScrollbar();
			}, 50);
		}
		
		// Use setTimeout with 0 delay instead of requestAnimationFrame for non-critical updates
		setTimeout(() => {
			cleanupAnimationWillChange();
		}, 0);
	})
	let scrollAnimationFrameId: number | null = null;

	window.swup.hooks.on('visit:start', (visit: {to: {url: string}}) => {
		if (scrollAnimationFrameId !== null) {
			cancelAnimationFrame(scrollAnimationFrameId);
			scrollAnimationFrameId = null;
		}

		const startScroll = window.pageYOffset || document.documentElement.scrollTop;
		if (startScroll > 0) {
			// Use CSS scroll-behavior for smoother animation when possible
			// Fallback to requestAnimationFrame for better control
			const minDuration = 200;
			const maxDuration = 300;
			const scrollDuration = Math.min(maxDuration, Math.max(minDuration, startScroll / 4 + 50));
			const startTime = performance.now();
			const startScrollValue = startScroll;
			
			const scrollToTop = (currentTime: number) => {
				const elapsed = currentTime - startTime;
				const progress = Math.min(elapsed / scrollDuration, 1);
				// Use simpler easing function for better performance
				const easeOutQuad = 1 - (1 - progress) * (1 - progress);
				const currentScroll = startScrollValue * (1 - easeOutQuad);
				
				window.scrollTo({
					top: currentScroll,
					behavior: 'auto'
				});
				
				if (progress < 1) {
					scrollAnimationFrameId = requestAnimationFrame(scrollToTop);
				} else {
					window.scrollTo({ top: 0, behavior: 'auto' });
					scrollAnimationFrameId = null;
				}
			};
			scrollAnimationFrameId = requestAnimationFrame(scrollToTop);
		} else {
			window.scrollTo({ top: 0, behavior: 'auto' });
		}

		// Hide TOC during transition to avoid flashing old content
		setTimeout(() => {
			const tocElement = document.getElementById('toc-wrapper');
			if (tocElement) {
				tocElement.classList.add('toc-not-ready')
			}
		}, 0);
	});
	
	window.swup.hooks.on('animation:in:end', () => {
		const sidebar = document.getElementById('sidebar');
		if (sidebar && window.innerWidth < 1024) {
			sidebar.style.display = '';
		}

		// Show TOC after new content is ready and animation finished
		const tocElement = document.getElementById('toc-wrapper');
		if (tocElement) {
			tocElement.classList.remove('toc-not-ready')
		}
	});
	
	window.swup.hooks.on('visit:end', (_visit: {to: {url: string}}) => {
		// Use setTimeout for non-critical updates
		setTimeout(() => {
			const tocElement = document.getElementById('toc-wrapper');
			if (tocElement && tocElement.classList.contains('toc-not-ready')) {
				tocElement.classList.remove('toc-not-ready')
			}
			
			const sidebar = document.getElementById('sidebar');
			if (sidebar && window.innerWidth < 1024) {
				sidebar.style.display = '';
			}
		}, 0);
	});
}
if (window?.swup?.hooks) {
	setup()
} else {
	document.addEventListener('swup:enable', setup)
}

// Cache DOM elements to avoid repeated queries
let backToTopBtn: HTMLElement | null = null;
let goToBottomBtn: HTMLElement | null = null;
let toc: HTMLElement | null = null;
let navbar: HTMLElement | null = null;

let bodyElement: HTMLElement | null = null;

// Initialize cached elements once
function initScrollElements() {
	backToTopBtn = document.getElementById('back-to-top-btn');
	goToBottomBtn = document.getElementById('go-to-bottom-btn');
	toc = document.getElementById('toc-wrapper');
	navbar = document.getElementById('navbar-wrapper');
	bodyElement = document.querySelector('body');
}

// Initialize on page load
initScrollElements();

let scrollTimeout: number | null = null;
let lastScrollTop = 0;
let lastBannerHeight = 0;
let lastIsHome = false;

function scrollFunction() {
	if (scrollTimeout !== null) {
		return;
	}
	
	scrollTimeout = requestAnimationFrame(() => {
		const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
		const innerHeight = window.innerHeight;
		const innerWidth = window.innerWidth;

		const bannerHeight = innerHeight * (BANNER_HEIGHT / 100);
		const isHome = bodyElement?.classList.contains('is-home') && innerWidth >= 1024;

		// Only update if scroll position changed significantly or state changed
		const scrollDelta = Math.abs(scrollTop - lastScrollTop);
		const bannerHeightChanged = bannerHeight !== lastBannerHeight;
		const isHomeChanged = isHome !== lastIsHome;
		
		if (scrollDelta < 5 && !bannerHeightChanged && !isHomeChanged) {
			scrollTimeout = null;
			return;
		}

		lastScrollTop = scrollTop;
		lastBannerHeight = bannerHeight;
		lastIsHome = !!isHome;

		// Batch DOM reads
		const scrollHeight = document.documentElement.scrollHeight;
		const clientHeight = document.documentElement.clientHeight;
		const isNearBottom = scrollTop + clientHeight >= scrollHeight - 100;
		const shouldShowBackToTop = scrollTop > bannerHeight;
		const shouldHideGoToBottom = isNearBottom;
		const shouldShowToc = bannerEnabled && scrollTop > bannerHeight;

		// Batch DOM writes
		if (backToTopBtn) {
			backToTopBtn.classList.toggle('hide', !shouldShowBackToTop);
		}

		if (goToBottomBtn) {
			goToBottomBtn.classList.toggle('hide', shouldHideGoToBottom);
		}

		if (bannerEnabled && toc) {
			toc.classList.toggle('toc-hide', !shouldShowToc);
		}

		if (bannerEnabled && navbar) {
			const NAVBAR_HEIGHT = 72;
			const MAIN_PANEL_EXCESS_HEIGHT = MAIN_PANEL_OVERLAPS_BANNER_HEIGHT * 16;
			const currentBannerHeight = isHome ? BANNER_HEIGHT_HOME : BANNER_HEIGHT;
			const threshold = innerHeight * (currentBannerHeight / 100) - NAVBAR_HEIGHT - MAIN_PANEL_EXCESS_HEIGHT - 16;
			
			navbar.classList.toggle('navbar-hidden', scrollTop >= threshold);
		}
		
		scrollTimeout = null;
	});
}

// Use passive event listener for better performance
window.addEventListener('scroll', scrollFunction, { passive: true });

let resizeTimeout: number | null = null;
window.onresize = () => {
	if (resizeTimeout !== null) {
		cancelAnimationFrame(resizeTimeout);
	}
	resizeTimeout = requestAnimationFrame(() => {
		// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
		let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
		offset = offset - offset % 4;
		document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		resizeTimeout = null;
	});
}

</script>

<script>
import PhotoSwipeLightbox from "photoswipe/lightbox"
import "photoswipe/style.css"

let lightbox: PhotoSwipeLightbox
let pswp = import("photoswipe")

function createPhotoSwipe() {
	lightbox = new PhotoSwipeLightbox({
		gallery: ".custom-md img, #post-cover img",
		pswpModule: () => pswp,
		closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
		zoomSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
		padding: { top: 20, bottom: 20, left: 20, right: 20 },
		wheelToZoom: true,
		arrowPrev: false,
		arrowNext: false,
		imageClickAction: 'close',
		tapAction: 'close',
		doubleTapAction: 'zoom',
		showHideAnimationType: 'fade',
	})

	lightbox.addFilter("domItemData", (itemData, element) => {
		if (element instanceof HTMLImageElement) {
			itemData.src = element.src

			itemData.w = Number(element.naturalWidth || window.innerWidth)
			itemData.h = Number(element.naturalHeight || window.innerHeight)

			itemData.msrc = element.src
		}

		return itemData
	})

	lightbox.init()
}

const setup = () => {
	if (!lightbox) {
		createPhotoSwipe()
	}
	window.swup.hooks.on("page:view", () => {
		createPhotoSwipe()
	})

	window.swup.hooks.on(
		"content:replace",
		() => {
			lightbox?.destroy?.()
		},
		{ before: true },
	)
}

if (window.swup) {
	setup()
} else {
	document.addEventListener("swup:enable", setup)
}
</script>
