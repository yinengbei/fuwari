*/

const bannerEnabled = !!document.getElementById('banner-wrapper')

function setClickOutsideToClose(panel: string, ignores: string[]) {
	document.addEventListener("click", event => {
		let panelDom = document.getElementById(panel);
		let tDom = event.target;
		if (!(tDom instanceof Node)) return;		// Ensure the event target is an HTML Node
		for (let ig of ignores) {
			let ie = document.getElementById(ig)
			if (ie == tDom || (ie?.contains(tDom))) {
				return;
			}
		}
		panelDom!.classList.add("float-panel-closed");
	});
}
setClickOutsideToClose("display-setting", ["display-setting", "display-settings-switch"])
setClickOutsideToClose("nav-menu-panel", ["nav-menu-panel", "nav-menu-switch"])
setClickOutsideToClose("search-panel", ["search-panel", "search-bar", "search-switch"])


function loadTheme() {
	const theme = getStoredTheme()
	setTheme(theme)
}

function loadHue() {
	setHue(getHue())
}

let bodyScrollbarInstance: any = null;

function initCustomScrollbar() {
	const bodyElement = document.querySelector('body');
	if (!bodyElement) return;
	
	// Optimize OverlayScrollbars configuration for better performance
	bodyScrollbarInstance = OverlayScrollbars(
		{
			target: bodyElement,
			cancel: {
				nativeScrollbarsOverlaid: true,    // don't initialize the overlay scrollbar if there is a native one
			}
		}, {
		scrollbars: {
			theme: 'scrollbar-base scrollbar-auto py-1',
			autoHide: 'move',
			autoHideDelay: 300,  // Reduced from 500ms for faster hiding
			autoHideSuspend: false,
			clickScroll: true,
		},
	});

	const katexElements = document.querySelectorAll('.katex-display') as NodeListOf<HTMLElement>;

	const katexObserverOptions = {
		root: null,
		rootMargin: '100px',
		threshold: 0.1
	};

	// Use requestIdleCallback for non-critical katex processing
	const processKatexElement = (element: HTMLElement) => {
		if (!element.parentNode) return;
		if (element.hasAttribute('data-scrollbar-initialized')) return;

		// Use requestIdleCallback to defer non-critical work
		const process = () => {
			if (!element.parentNode) return;
			
			const container = document.createElement('div');
			container.className = 'katex-display-container';
			container.setAttribute('aria-label', 'scrollable container for formulas');

			element.parentNode.insertBefore(container, element);
			container.appendChild(element);

			OverlayScrollbars(container, {
				scrollbars: {
					theme: 'scrollbar-base scrollbar-auto',
					autoHide: 'leave',
					autoHideDelay: 300,  // Reduced delay
					autoHideSuspend: false
				},
			});

			element.setAttribute('data-scrollbar-initialized', 'true');
		};

		// Use requestIdleCallback if available, otherwise setTimeout
		if ('requestIdleCallback' in window) {
			(window as any).requestIdleCallback(process, { timeout: 1000 });
		} else {
			setTimeout(process, 0);
		}
	};

	const katexObserver = new IntersectionObserver((entries, observer) => {
		// Process entries in batches to avoid blocking
		entries.forEach((entry, index) => {
			if (entry.isIntersecting) {
				// Stagger processing to avoid blocking
				setTimeout(() => {
					processKatexElement(entry.target as HTMLElement);
					observer.unobserve(entry.target);
				}, index * 10);
			}
		});
	}, katexObserverOptions);

	katexElements.forEach(element => {
		katexObserver.observe(element);
	});
}

function showBanner() {
	if (!siteConfig.banner.enable) return;

	const banner = document.getElementById('banner');
	if (!banner) {
		console.error('Banner element not found');
		return;
	}

	banner.classList.remove('opacity-0', 'scale-105');
}

function cleanupAnimationWillChange() {
	const animatedElements = document.querySelectorAll('.onload-animation');
	animatedElements.forEach((element) => {
		const handleAnimationEnd = (event: Event) => {
			const animEvent = event as AnimationEvent;
			if (animEvent.target === element) {
				(element as HTMLElement).classList.add('animation-complete');
				element.removeEventListener('animationend', handleAnimationEnd as EventListener);
			}
		};
		element.addEventListener('animationend', handleAnimationEnd as EventListener);
	});
}

function registerServiceWorker() {
	if ('serviceWorker' in navigator) {
		window.addEventListener('load', () => {
			navigator.serviceWorker.register('/sw.js')
				.then((registration) => {
					console.log('Service Worker registered:', registration.scope);
					
					// Check for updates
					registration.addEventListener('updatefound', () => {
						const newWorker = registration.installing;
						if (newWorker) {
							newWorker.addEventListener('statechange', () => {
								if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
									// New service worker available, notify user
									console.log('New service worker available');
								}
							});
						}
					});
				})
				.catch((error) => {
					console.error('Service Worker registration failed:', error);
				});
		});
	}
}

function init() {
	// disableAnimation()()		// TODO
	loadTheme();
	loadHue();
	showBanner();
	cleanupAnimationWillChange();
	registerServiceWorker();
	
	// Delay OverlayScrollbars initialization to avoid blocking initial render
	// Use requestIdleCallback if available, otherwise setTimeout
	if ('requestIdleCallback' in window) {
		(window as any).requestIdleCallback(() => {
			initCustomScrollbar();
		}, { timeout: 2000 });
	} else {
		setTimeout(() => {
			initCustomScrollbar();
		}, 100);
	}
}

/* Load settings when entering the site */
init();

let scrollAnimationFrameId: number | null = null;

const setup = () => {
	// TODO: temp solution to change the height of the banner
/*
	window.swup.hooks.on('animation:out:start', () => {
		const path = window.location.pathname
		const body = document.querySelector('body')
		if (path[path.length - 1] === '/' && !body.classList.contains('is-home')) {
			body.classList.add('is-home')
		} else if (path[path.length - 1] !== '/' && body.classList.contains('is-home')) {
			body.classList.remove('is-home')
		}
	})
*/
	window.swup.hooks.on('link:click', () => {
		document.documentElement.style.setProperty('--content-delay', '0ms')

		const sidebar = document.getElementById('sidebar');
		if (sidebar && window.innerWidth < 1024) {
			sidebar.style.display = 'none';
		}

		// Use setTimeout for non-critical DOM updates to avoid blocking
		setTimeout(() => {
			if (!bannerEnabled) {
				return
			}
			const threshold = window.innerHeight * (BANNER_HEIGHT / 100) - 72 - 16
			const navbar = document.getElementById('navbar-wrapper')
			if (!navbar || !document.body.classList.contains('lg:is-home')) {
				return
			}
			const scrollTop = document.body.scrollTop || document.documentElement.scrollTop;
			if (scrollTop >= threshold) {
				navbar.classList.add('navbar-hidden')
			}
		}, 0);
	})
	window.swup.hooks.on('content:replace', () => {
		// Stop any ongoing scroll animation
		if (scrollAnimationFrameId !== null) {
			cancelAnimationFrame(scrollAnimationFrameId);
			scrollAnimationFrameId = null;
		}

		// Re-initialize cached elements after content replacement
		initScrollElements();
		
		const sidebar = document.getElementById('sidebar');
		if (sidebar && window.innerWidth < 1024) {
			sidebar.style.display = 'none';
		}
		
		// Delay scrollbar re-initialization to avoid blocking
		if ('requestIdleCallback' in window) {
			(window as any).requestIdleCallback(() => {
				initCustomScrollbar();
			}, { timeout: 1000 });
		} else {
			setTimeout(() => {
				initCustomScrollbar();
			}, 50);
		}
		
		// Use setTimeout with 0 delay instead of requestAnimationFrame for non-critical updates
		setTimeout(() => {
			cleanupAnimationWillChange();
		}, 0);
	})
	window.swup.hooks.on('visit:start', (visit: {to: {url: string}}) => {
		if (scrollAnimationFrameId !== null) {
			cancelAnimationFrame(scrollAnimationFrameId);
			scrollAnimationFrameId = null;
		}

		const startScroll = window.pageYOffset || document.documentElement.scrollTop;
		if (startScroll > 0) {
			// Use a more relaxed duration and cubic easing for smoother animation
			const minDuration = 300;
			const maxDuration = 600;
			const scrollDuration = Math.min(maxDuration, Math.max(minDuration, startScroll / 6 + 100));
			const startTime = performance.now();
			const startScrollValue = startScroll;
			
			const scrollToTop = (currentTime: number) => {
				const elapsed = currentTime - startTime;
				const progress = Math.min(elapsed / scrollDuration, 1);
				
				// Cubic ease-out is smoother than quadratic
				const easeOutCubic = 1 - Math.pow(1 - progress, 3);
				const currentScroll = startScrollValue * (1 - easeOutCubic);
				
				window.scrollTo(0, currentScroll);
				
				if (progress < 1) {
					scrollAnimationFrameId = requestAnimationFrame(scrollToTop);
				} else {
					window.scrollTo(0, 0);
					scrollAnimationFrameId = null;
				}
			};
			scrollAnimationFrameId = requestAnimationFrame(scrollToTop);
		} else {
			window.scrollTo(0, 0);
		}

		// Use setTimeout for non-critical DOM updates
		setTimeout(() => {
			const bodyElement = document.querySelector('body')
			if (pathsEqual(visit.to.url, url('/'))) {
				bodyElement!.classList.add('lg:is-home');
			} else {
				bodyElement!.classList.remove('lg:is-home');
			}

			const tocElement = document.getElementById('toc-wrapper');
			if (tocElement) {
				tocElement.classList.add('toc-not-ready')
			}
		}, 0);
	});
	window.swup.hooks.on('page:view', () => {});
	
	window.swup.hooks.on('animation:out:end', () => {
		// Use setTimeout for non-critical updates
		setTimeout(() => {
			const tocElement = document.getElementById('toc-wrapper');
			if (tocElement) {
				tocElement.classList.remove('toc-not-ready')
			}
		}, 0);
	});
	
	window.swup.hooks.on('animation:in:end', () => {
		const sidebar = document.getElementById('sidebar');
		if (sidebar && window.innerWidth < 1024) {
			sidebar.style.display = '';
		}
	});
	
	window.swup.hooks.on('visit:end', (_visit: {to: {url: string}}) => {
		// Use setTimeout for non-critical updates
		setTimeout(() => {
			const tocElement = document.getElementById('toc-wrapper');
			if (tocElement && tocElement.classList.contains('toc-not-ready')) {
				tocElement.classList.remove('toc-not-ready')
			}
			
			const sidebar = document.getElementById('sidebar');
			if (sidebar && window.innerWidth < 1024) {
				sidebar.style.display = '';
			}
		}, 0);
	});
}
if (window?.swup?.hooks) {
	setup()
} else {
	document.addEventListener('swup:enable', setup)
}

// Cache DOM elements to avoid repeated queries
let backToTopBtn: HTMLElement | null = null;
let goToBottomBtn: HTMLElement | null = null;
let toc: HTMLElement | null = null;
let navbar: HTMLElement | null = null;

let bodyElement: HTMLElement | null = null;

// Initialize cached elements once
function initScrollElements() {
	backToTopBtn = document.getElementById('back-to-top-btn');
	goToBottomBtn = document.getElementById('go-to-bottom-btn');
	toc = document.getElementById('toc-wrapper');
	navbar = document.getElementById('navbar-wrapper');
	bodyElement = document.querySelector('body');
}

// Initialize on page load
initScrollElements();

let scrollTimeout: number | null = null;
let lastScrollTop = 0;
let lastBannerHeight = 0;
let lastIsHome = false;

function scrollFunction() {
	if (scrollTimeout !== null || scrollAnimationFrameId !== null) {
		return;
	}
	
	scrollTimeout = requestAnimationFrame(() => {
		const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
		const innerHeight = window.innerHeight;
		const innerWidth = window.innerWidth;

		const bannerHeight = innerHeight * (BANNER_HEIGHT / 100);
		const isHome = bodyElement?.classList.contains('lg:is-home') && innerWidth >= 1024;

		// Only update if scroll position changed significantly or state changed
		const scrollDelta = Math.abs(scrollTop - lastScrollTop);
		const bannerHeightChanged = bannerHeight !== lastBannerHeight;
		const isHomeChanged = isHome !== lastIsHome;
		
		if (scrollDelta < 5 && !bannerHeightChanged && !isHomeChanged) {
			scrollTimeout = null;
			return;
		}

		lastScrollTop = scrollTop;
		lastBannerHeight = bannerHeight;
		lastIsHome = !!isHome;

		// Batch DOM reads
		const scrollHeight = document.documentElement.scrollHeight;
		const clientHeight = document.documentElement.clientHeight;
		const isNearBottom = scrollTop + clientHeight >= scrollHeight - 100;
		const shouldShowBackToTop = scrollTop > bannerHeight;
		const shouldHideGoToBottom = isNearBottom;
		const shouldShowToc = bannerEnabled && scrollTop > bannerHeight;

		// Batch DOM writes
		if (backToTopBtn) {
			backToTopBtn.classList.toggle('hide', !shouldShowBackToTop);
		}

		if (goToBottomBtn) {
			goToBottomBtn.classList.toggle('hide', shouldHideGoToBottom);
		}

		if (bannerEnabled && toc) {
			toc.classList.toggle('toc-hide', !shouldShowToc);
		}

		if (bannerEnabled && navbar) {
			const NAVBAR_HEIGHT = 72;
			const MAIN_PANEL_EXCESS_HEIGHT = MAIN_PANEL_OVERLAPS_BANNER_HEIGHT * 16;
			const currentBannerHeight = isHome ? BANNER_HEIGHT_HOME : BANNER_HEIGHT;
			const threshold = innerHeight * (currentBannerHeight / 100) - NAVBAR_HEIGHT - MAIN_PANEL_EXCESS_HEIGHT - 16;
			
			navbar.classList.toggle('navbar-hidden', scrollTop >= threshold);
		}
		
		scrollTimeout = null;
	});
}

// Use passive event listener for better performance
window.addEventListener('scroll', scrollFunction, { passive: true });

let resizeTimeout: number | null = null;
window.onresize = () => {
	if (resizeTimeout !== null) {
		cancelAnimationFrame(resizeTimeout);
	}
	resizeTimeout = requestAnimationFrame(() => {
		// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
		let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
		offset = offset - offset % 4;
		document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
		resizeTimeout = null;
	});
}

</script>

<script>
import PhotoSwipeLightbox from "photoswipe/lightbox"
import "photoswipe/style.css"

let lightbox: PhotoSwipeLightbox
let pswp = import("photoswipe")

function createPhotoSwipe() {
	lightbox = new PhotoSwipeLightbox({
		gallery: ".custom-md img, #post-cover img",
		pswpModule: () => pswp,
		closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
		zoomSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
		padding: { top: 20, bottom: 20, left: 20, right: 20 },
		wheelToZoom: true,
		arrowPrev: false,
		arrowNext: false,
		imageClickAction: 'close',
		tapAction: 'close',
		doubleTapAction: 'zoom',
		showHideAnimationType: 'fade',
	})

	lightbox.addFilter("domItemData", (itemData, element) => {
		if (element instanceof HTMLImageElement) {
			itemData.src = element.src

			itemData.w = Number(element.naturalWidth || window.innerWidth)
			itemData.h = Number(element.naturalHeight || window.innerHeight)

			itemData.msrc = element.src
		}

		return itemData
	})

	lightbox.init()
}

const setup = () => {
	if (!lightbox) {
		createPhotoSwipe()
	}
	window.swup.hooks.on("page:view", () => {
		createPhotoSwipe()
	})

	window.swup.hooks.on(
		"content:replace",
		() => {
			lightbox?.destroy?.()
		},
		{ before: true },
	)
}

if (window.swup) {
	setup()
} else {
	document.addEventListener("swup:enable", setup)
}
</script>
