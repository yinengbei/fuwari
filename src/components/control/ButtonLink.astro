---
interface Props {
	badge?: string;
	url?: string;
	label?: string;
	target?: string;
	rel?: string;
}
const { badge, url, label, target, rel } = Astro.props;
---
<a href={url} aria-label={label} target={target} rel={rel}>
    <button
        class:list={`
            w-full
            h-10
            rounded-lg
            bg-none
            hover:bg-[var(--btn-plain-bg-hover)]
            active:bg-[var(--btn-plain-bg-active)]
            transition-all
            pl-2
            hover:pl-3
            
            text-neutral-700
            hover:text-[var(--primary)]
        `
        }
    >
        <div class="flex items-center justify-between relative mr-2 gap-2">
            <div class="flex-1 min-w-0 overflow-hidden text-left">
                <slot></slot>
            </div>
            { badge !== undefined && badge !== null && badge !== '' &&
                <div class="transition px-2 h-7 flex-shrink-0 rounded-lg text-sm font-bold
                    text-[var(--btn-content)]
                    bg-[var(--btn-regular-bg)]
                    flex items-center justify-center whitespace-nowrap">
                    { badge }
                </div>
            }
        </div>
    </button>
</a>
