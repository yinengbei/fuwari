---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="scroll-buttons-wrapper hidden lg:block">
    <div id="back-to-top-btn" class="scroll-btn back-to-top-btn hide flex items-center rounded-2xl overflow-hidden transition" onclick="backToTop()">
        <button aria-label="Back to Top" class="btn-card h-[3.75rem] w-[3.75rem]">
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
        </button>
    </div>
    <div id="go-to-bottom-btn" class="scroll-btn go-to-bottom-btn hide flex items-center rounded-2xl overflow-hidden transition" onclick="goToBottom()">
        <button aria-label="Go to Bottom" class="btn-card h-[3.75rem] w-[3.75rem]">
            <Icon name="material-symbols:keyboard-arrow-down-rounded" class="mx-auto"></Icon>
        </button>
    </div>
</div>

<style lang="stylus">
.scroll-buttons-wrapper
    width: 3.75rem
    height: 3.75rem
    position: absolute
    right: 0
    top: 0
    pointer-events: none

.scroll-btn
    color: var(--primary)
    font-size: 2.25rem
    font-weight: bold
    border: none
    position: fixed
    opacity: 1
    cursor: pointer
    transform: translateX(5rem)
    pointer-events: auto
    i
        font-size: 1.75rem
    &.hide
        transform: translateX(5rem) scale(0.9)
        opacity: 0
        pointer-events: none
    &:active
      transform: translateX(5rem) scale(0.9)

.back-to-top-btn
    bottom: 10rem

.go-to-bottom-btn
    bottom: 5rem

</style>

<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}

function goToBottom() {
    window.scroll({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
}
</script>
