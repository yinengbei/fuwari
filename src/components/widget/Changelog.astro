---
import ButtonLink from "../control/ButtonLink.astro";
import WidgetLayout from "./WidgetLayout.astro";

interface Commit {
	message: string;
	date: string;
	dateFormatted: string;
	url: string;
	sha: string;
	author?: string;
}

interface ChangelogConfig {
	repoUrl?: string;
	perPage?: number;
	showAuthor?: boolean;
	collapseThreshold?: number;
	collapsedHeight?: string;
}

function formatCommitMessage(message: string): string {
	const firstLine = message.split("\n")[0].trim();

	const typePrefixPattern =
		/^(feat|fix|chore|docs|style|refactor|perf|test|build|ci|revert)(\(.+\))?:\s*/i;
	const cleaned = firstLine.replace(typePrefixPattern, "");

	return cleaned || firstLine;
}

function formatDate(dateString: string): string {
	const date = new Date(dateString);
	const now = new Date();
	const diffTime = now.getTime() - date.getTime();
	const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

	if (diffDays === 0) {
		return "今天";
	}
	if (diffDays === 1) {
		return "昨天";
	}
	if (diffDays < 7) {
		return `${diffDays} 天前`;
	}
	if (diffDays < 30) {
		const weeks = Math.floor(diffDays / 7);
		return `${weeks} 周前`;
	}
	if (diffDays < 365) {
		const months = Math.floor(diffDays / 30);
		return `${months} 个月前`;
	}
	const years = Math.floor(diffDays / 365);
	return `${years} 年前`;
}

function getRepoUrl(): string {
	return "https://github.com/yinengbei/fuwari";
}

function extractRepoInfo(
	repoUrl: string,
): { owner: string; repo: string } | null {
	const match = repoUrl.match(/github\.com\/([^/]+)\/([^/]+)/);
	if (!match) {
		return null;
	}

	return {
		owner: match[1],
		repo: match[2].replace(/\/$/, ""),
	};
}

function getGitHubToken(): string | undefined {
	// @ts-expect-error - import.meta.env type definition issue
	const env = import.meta.env as Record<string, string | undefined>;
	return env.GITHUB_TOKEN || env.GH_TOKEN || env.GITHUB_PERSONAL_ACCESS_TOKEN;
}

async function getChangelogList(config: ChangelogConfig): Promise<Commit[]> {
	const repoUrl = getRepoUrl();
	const repoInfo = extractRepoInfo(repoUrl);
	if (!repoInfo) {
		console.warn(`[Changelog] 无法解析仓库 URL: ${repoUrl}`);
		return [];
	}

	const { owner, repo } = repoInfo;
	const perPage = config.perPage || 10;
	const token = getGitHubToken();

	const headers: HeadersInit = {
		"User-Agent": "Fuwari-Changelog-Widget",
		Accept: "application/vnd.github.v3+json",
	};

	if (token) {
		headers.Authorization = `token ${token}`;
	}

	try {
		const response = await fetch(
			`https://api.github.com/repos/${owner}/${repo}/commits?per_page=${perPage}`,
			{
				headers,
			},
		);

		if (!response.ok) {
			if (response.status === 404) {
				console.warn(`[Changelog] 仓库不存在: ${owner}/${repo}`);
			} else if (response.status === 403) {
				if (token) {
					console.warn(
						"[Changelog] API 请求被限制，可能是 token 权限不足或已过期",
					);
				} else {
					console.warn(
						"[Changelog] API 请求被限制，建议设置 GITHUB_TOKEN 环境变量以提高速率限制",
					);
				}
			} else if (response.status === 401) {
				console.warn(
					"[Changelog] 认证失败，请检查 GITHUB_TOKEN 环境变量是否正确",
				);
			} else {
				console.error(
					`[Changelog] 获取提交失败: ${response.status} ${response.statusText}`,
				);
			}
			return [];
		}

		const data = await response.json();

		if (!Array.isArray(data)) {
			console.error("[Changelog] API 返回的数据格式不正确");
			return [];
		}

		return data.map(
			(commit: {
				commit: {
					message: string;
					author: { date: string; name?: string };
				};
				html_url: string;
				sha: string;
			}) => {
				const commitDate = commit.commit.author.date;
				return {
					message: formatCommitMessage(commit.commit.message),
					date: new Date(commitDate).toISOString().split("T")[0],
					dateFormatted: formatDate(commitDate),
					url: commit.html_url,
					sha: commit.sha.substring(0, 7),
					author: config.showAuthor ? commit.commit.author.name : undefined,
				};
			},
		);
	} catch (e) {
		console.error("[Changelog] 获取提交时发生错误:", e);
		return [];
	}
}

interface Props extends ChangelogConfig {
	class?: string;
	style?: string;
}

const config: ChangelogConfig = {
	repoUrl: Astro.props.repoUrl,
	perPage: Astro.props.perPage || 10,
	showAuthor: Astro.props.showAuthor || false,
	collapseThreshold: Astro.props.collapseThreshold || 5,
	collapsedHeight: Astro.props.collapsedHeight || "7.5rem",
};

const commits = await getChangelogList(config);
const className = Astro.props.class;
const style = Astro.props.style;

const collapseThreshold = config.collapseThreshold ?? 5;
const isCollapsed = commits.length >= collapseThreshold;
---

<WidgetLayout
	name="更新日志"
	id="changelog"
	isCollapsed={isCollapsed}
	collapsedHeight={config.collapsedHeight}
	class={className}
	style={style}
>
	{commits.length === 0 ? (
		<div class="px-4 py-6 text-center text-neutral-500 text-sm">
			<p>暂无更新记录</p>
			<p class="mt-2 text-xs">请检查仓库配置或网络连接</p>
		</div>
	) : (
		commits.map((c) => (
			<ButtonLink
				url={c.url}
				badge={c.dateFormatted}
				label={`查看提交: ${c.message} (${c.sha})`}
				target="_blank"
				rel="noopener noreferrer"
			>
				<div class="flex flex-col items-start gap-1 min-w-0 w-full">
					<span class="text-sm truncate w-full">{c.message}</span>
					{c.author && (
						<span class="text-xs text-neutral-500 truncate w-full">by {c.author}</span>
					)}
				</div>
			</ButtonLink>
		))
	)}
</WidgetLayout>
