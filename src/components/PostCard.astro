---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import PostMetadata from "./PostMeta.astro";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	style: string;
	loading?: "lazy" | "eager";
	preload?: boolean;
}
const {
	entry,
	title,
	url,
	published,
	updated,
	tags,
	category,
	image,
	description,
	style,
	loading = "lazy",
	preload = false,
} = Astro.props;
const className = Astro.props.class;

const hasCover = image !== undefined && image !== null && image !== "";

const coverWidth = "28%";

const { remarkPluginFrontmatter } = await entry.render();
---
<div class:list={[
  "card-base flex flex-row md:flex-col w-full rounded-[var(--radius-large)] overflow-hidden relative shadow-sm md:shadow-md hover:shadow-lg transition-shadow",
  className
]} style={style}>
  <div class:list={[
    "flex-1 pl-4 md:pl-9 pr-4 md:pr-2 pt-4 md:pt-7 pb-4 md:pb-6 relative",
    {"w-full md:w-[calc(100%_-_52px_-_12px)]": !hasCover, "w-full md:w-[calc(100%_-_var(--coverWidth)_-_12px)]": hasCover}
  ]}>

    {entry.data.pinned && (
      <span class="inline-flex items-center mb-1 px-2 py-0.5 rounded-full text-xs font-medium bg-[var(--primary)]/10 text-[var(--primary)]">
        <Icon name="material-symbols:push-pin" class="mr-1 text-sm" />
        置顶
      </span>
    )}

    <a href={url}
       class="transition group w-full block font-bold mb-2 md:mb-3 text-2xl md:text-3xl text-90
              hover:text-[var(--primary)] dark:hover:text-[var(--primary)]
              active:text-[var(--title-active)] dark:active:text-[var(--title-active)]
              before:w-1 before:h-4 md:before:h-5 before:rounded-md before:bg-[var(--primary)]
              before:absolute before:top-[28px] md:top-[35px] before:left-[14px] md:left-[18px] before:hidden md:before:block">

      {title}
      <Icon class="inline text-[1.8rem] text-[var(--primary)] md:hidden translate-y-0.5 absolute" name="material-symbols:chevron-right-rounded"></Icon>
      <Icon class="text-[var(--primary)] text-[2rem] transition hidden md:inline absolute translate-y-0.5 opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0" name="material-symbols:chevron-right-rounded"></Icon>
    </a>

    <PostMetadata
      published={published}
      updated={updated}
      tags={tags}
      category={category}
      hideTagsForMobile={true}
      hideUpdateDate={true}
      class="mb-3 md:mb-4"
    />

    <div class:list={["transition text-75 mb-3 pr-2 md:pr-4", {"line-clamp-2 md:line-clamp-1": !description}]}>
      { description || remarkPluginFrontmatter.excerpt }
    </div>

    <div class="text-sm text-black/45 dark:text-white/45 flex gap-3 md:gap-4 transition flex-wrap items-center">
      <div>{remarkPluginFrontmatter.words} 字</div>
      <div class="hidden md:block">|</div>
      <div>{remarkPluginFrontmatter.minutes} 分钟</div>
      <div class="hidden md:block">|</div>
      <div class="post-card-views-container opacity-0 transition-opacity duration-500 hidden md:block" data-post-url={url}>
        <span class="post-card-view-count">...</span> 次阅读
      </div>
    </div>
  </div>

  {hasCover && 
    <a href={url} aria-label={title}
       class:list={["group max-h-[25vh] mx-2 my-3 w-24 sm:w-28 flex-shrink-0 relative rounded-xl overflow-hidden active:scale-95 md:max-h-none md:mx-0 md:mt-0 md:mb-0 md:w-auto md:flex-shrink md:absolute md:top-3 md:bottom-3 md:right-3"]}>
      <div class="absolute pointer-events-none z-10 w-full h-full group-hover:bg-black/30 group-active:bg-black/50 transition"></div>
      <div class="absolute pointer-events-none z-20 w-full h-full flex items-center justify-center">
        <Icon name="material-symbols:chevron-right-rounded" class="transition opacity-0 group-hover:opacity-100 scale-50 group-hover:scale-100 text-white text-4xl md:text-5xl"/>
      </div>
      <ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt="Cover Image of the Post" class="w-full h-full" loading={loading} fetchpriority={loading === "eager" ? "high" : "auto"} preload={preload} sizes="(max-width: 640px) 100px, (max-width: 1024px) 112px, 28vw"/>
    </a>
  }

  {!hasCover &&
    <a href={url} aria-label={title} class="!hidden md:!flex btn-regular w-[3.25rem] absolute right-3 top-3 bottom-3 rounded-xl bg-[var(--enter-btn-bg)] hover:bg-[var(--enter-btn-bg-hover)] active:bg-[var(--enter-btn-bg-active)] active:scale-95">
      <Icon name="material-symbols:chevron-right-rounded" class="transition text-[var(--primary)] text-4xl mx-auto"/>
    </a>
  }
</div>

<style define:vars={{coverWidth}}></style>

<script>
  function updatePostCardViews() {
    const containers = document.querySelectorAll('.post-card-views-container[data-post-url]');
    
    containers.forEach((container) => {
      if (container instanceof HTMLElement && container.dataset.fetched !== 'true') {
        container.dataset.fetched = 'true';
        const postUrl = container.dataset.postUrl;
        const countSpan = container.querySelector('.post-card-view-count');
        
        if (!countSpan || !postUrl) return;
        
        fetch(`/api/views?id=${encodeURIComponent(postUrl)}&action=get`)
          .then(res => {
            if (!res.ok) {
              throw new Error(`HTTP error! status: ${res.status}`);
            }
            return res.json();
          })
          .then(data => {
            if (typeof data.visitCount === 'number') {
              countSpan.textContent = data.visitCount.toLocaleString();
              container.classList.remove('opacity-0');
            }
          })
          .catch(err => {
            console.error('[PostCardViews] fetch failed:', err);
            delete container.dataset.fetched;
          });
      }
    });
  }

  if (typeof window !== 'undefined') {
    if (!(window as any).__postCardViewsInitialized) {
      (window as any).__postCardViewsInitialized = true;

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', updatePostCardViews, { once: true });
      } else {
        updatePostCardViews();
      }
    }

    const setupSwupHandler = () => {
      if (window.swup?.hooks && !(window as any).__postCardViewsSwupHandlerRegistered) {
        (window as any).__postCardViewsSwupHandlerRegistered = true;
        
        window.swup.hooks.on('content:replace', () => {
          const containers = document.querySelectorAll('.post-card-views-container[data-post-url]');
          containers.forEach((container) => {
            if (container instanceof HTMLElement) {
              delete container.dataset.fetched;
            }
          });
          setTimeout(updatePostCardViews, 0);
        });
      }
    };

    if (window.swup?.hooks) {
      setupSwupHandler();
    } else {
      document.addEventListener('swup:enable', setupSwupHandler, { once: true });
    }
  }
</script>

