<div id="loading-spinner" class="loading-spinner">
    <img src="/loading.gif" alt="Loading" class="loading-gif" />
</div>

<style>
    .loading-spinner {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: var(--page-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        opacity: 1;
        transition: opacity 0.4s ease-out, visibility 0.4s;
        visibility: visible;
    }

    /* Dark mode override */
    :global(.dark) .loading-spinner {
        background: oklch(0.12 0.01 var(--hue));
    }

    .loading-spinner.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }

    .loading-gif {
        width: 480px;
        height: 480px;
        max-width: 80vw;
        max-height: 80vh;
        object-fit: contain;
    }
</style>

<script>
    let spinnerHidden = false;

    function hideLoadingSpinner() {
        if (spinnerHidden) return;
        spinnerHidden = true;
        
        const spinner = document.getElementById('loading-spinner');
        if (spinner) {
            spinner.classList.add('hidden');
            setTimeout(() => {
                if (spinner.parentNode) {
                    spinner.remove();
                }
            }, 500);
        }
    }

    if (document.readyState === 'complete') {
        setTimeout(hideLoadingSpinner, 300);
    } else {
        window.addEventListener('load', () => {
            setTimeout(hideLoadingSpinner, 300);
        });
    }

    const setupSwupHandler = () => {
        if (window.swup?.hooks) {
            window.swup.hooks.on('page:view', () => {
                setTimeout(hideLoadingSpinner, 100);
            });
        }
    };

    if (window.swup) {
        setupSwupHandler();
    } else {
        document.addEventListener('swup:enable', setupSwupHandler);
    }
</script>
