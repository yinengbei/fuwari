---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";
---

<MainGridLayout title="404 - 页面未找到" description="抱歉，您访问的页面不存在">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-12 relative w-full flex flex-col items-center justify-center text-center">
            <div class="text-8xl md:text-9xl font-bold text-[var(--primary)] mb-4 transition">
                404
            </div>
            
            <div class="mb-6">
                <Icon 
                    name="material-symbols:error-outline-rounded" 
                    class="text-6xl text-[var(--primary)] transition"
                />
            </div>
            
            <h1 class="text-2xl md:text-3xl font-bold text-90 mb-3 transition">
                页面未找到喵
            </h1>
            
            <p class="text-base md:text-lg text-black/60 dark:text-white/60 mb-8 max-w-md transition">
                抱歉，访问的页面不存在或已被移动喵。
                <br />
                请检查网址是否正确，或返回首页喵。
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 items-center justify-center">
                <a 
                    href={url("/")} 
                    class="btn-regular rounded-lg h-12 px-6 font-bold text-base flex items-center gap-2 active:scale-95 transition"
                >
                    <Icon name="material-symbols:home-rounded" class="text-xl" />
                    返回首页
                </a>
                
                <button 
                    onclick="window.history.back()" 
                    class="btn-plain rounded-lg h-12 px-6 font-bold text-base flex items-center gap-2 active:scale-95 transition"
                >
                    <Icon name="material-symbols:arrow-back-rounded" class="text-xl" />
                    返回上一页
                </button>
            </div>
            
            <div class="w-full max-w-md my-8 border-t border-black/10 dark:border-white/15 transition"></div>
            
            <div class="flex flex-wrap gap-4 items-center justify-center text-sm">
                <a href={url("/archive/")} class="link text-[var(--primary)] font-medium">
                    归档
                </a>
                <span class="text-black/40 dark:text-white/40">•</span>
                <a href={url("/categories/")} class="link text-[var(--primary)] font-medium">
                    分类
                </a>
                <span class="text-black/40 dark:text-white/40">•</span>
                <a href={url("/about/")} class="link text-[var(--primary)] font-medium">
                    关于
                </a>
            </div>
        </div>
    </div>
</MainGridLayout>

